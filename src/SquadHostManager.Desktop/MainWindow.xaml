                            </StackPanel></Border>
                            <Border Visibility="{Binding Visibility,ElementName=HostLivePanel}" Background="#141711" CornerRadius="16" Padding="24" Margin="0,0,0,18"><StackPanel x:Name="HostLivePanel" Visibility="Collapsed">
