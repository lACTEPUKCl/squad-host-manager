                                <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock x:Name="HostLiveInfo" TextWrapping="Wrap" Margin="0,0,0,12"/><TextBlock x:Name="HostLiveTiming" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"/></StackPanel>
                                <ScrollViewer Grid.Column="2" MaxHeight="240" VerticalScrollBarVisibility="Auto" Focusable="False"><TextBlock x:Name="HostLiveJournal" TextWrapping="Wrap" Focusable="False" IsHitTestVisible="False" LineHeight="22"/></ScrollViewer></Grid>
                                <Button x:Name="RetryHostButton" Visibility="Collapsed" Content="{DynamicResource retryHostPreparation}" Click="RetryHostClick" HorizontalAlignment="Left" Margin="0,16,0,0" Style="{StaticResource PrimaryButton}"/><Button x:Name="ReleaseEmptyHostButton" Visibility="Collapsed" Content="{DynamicResource release}" Click="ReleaseClick" HorizontalAlignment="Left" Margin="0,20,0,0"/>
                            </StackPanel></Border>
                            <TextBlock x:Name="RentalPermissionHelp" TextWrapping="Wrap" Margin="0,0,0,20" Visibility="Collapsed"/><StackPanel x:Name="RentalCitiesPanel" Margin="0,0,0,12"><TextBlock Text="{DynamicResource selectRentalCity}" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="AMD Ryzen 9950X" FontWeight="SemiBold" Margin="0,8"/><DockPanel><Button x:Name="LocationBell" Click="LocationBellClick" DockPanel.Dock="Right" Padding="10" Margin="10,0,0,0" ToolTip="{DynamicResource watchCitiesTitle}" AutomationProperties.Name="{DynamicResource watchCitiesTitle}"><Canvas Width="20" Height="20"><Path Data="M5 13 V9 Q5 4 10 4 Q15 4 15 9 V13 L17 15 H3 Z M8 17 Q10 20 12 17 M10 2 V4" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Canvas></Button><Button Click="LocationsRefreshClick" DockPanel.Dock="Right" Padding="10" Margin="12,0,0,0" ToolTip="{DynamicResource refresh}" AutomationProperties.Name="{DynamicResource refresh}"><Canvas Width="18" Height="18"><Path Data="M15 6 A6 6 0 1 0 15 12 M15 2 V6 H11" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Canvas></Button><ComboBox x:Name="RentalCities" DisplayMemberPath="Display" MinWidth="0" SelectionChanged="RentalCitySelected"/></DockPanel><TextBlock x:Name="RentalOfferPrice" FontSize="36" FontWeight="Medium" Margin="0,22,0,6"/><TextBlock x:Name="RentalOfferAvailability" Foreground="{StaticResource AccentBrush}" FontSize="12" Margin="0,0,0,16"/><TextBlock x:Name="RentalOffer" TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8"/><Button x:Name="RentHostButton" Style="{StaticResource PrimaryButton}" Content="{DynamicResource rentHost}" Click="RentHostClick" HorizontalAlignment="Left" Padding="18,9" Margin="0,8,0,12"/><TextBlock Text="{DynamicResource rentalCityHelp}" TextWrapping="Wrap" Margin="0,8"/></StackPanel><TextBlock x:Name="RentalDescription" TextWrapping="Wrap" FontSize="17" Margin="0,0,0,10"/>
                            <TextBlock x:Name="RentalCapacity" TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <TextBlock x:Name="RentalCosts" TextWrapping="Wrap" Margin="0,0,0,8"/>
