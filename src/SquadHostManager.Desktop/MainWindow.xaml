                                <Label Content="{DynamicResource username}" Target="{Binding ElementName=Username}" Padding="0"/>
                                <TextBox x:Name="Username" Padding="12,8" Text="admin" Margin="0,8,0,16"/>
                                <Label Content="{DynamicResource accountPassword}" Target="{Binding ElementName=AccountPassword}" Padding="0"/>
                                <PasswordBox x:Name="AccountPassword" Padding="12,8" Margin="0,8,0,18"/>
                                <WrapPanel><Button Style="{StaticResource PrimaryButton}" Content="{DynamicResource login}" Click="LoginClick" Margin="0,0,12,0"/><Button Content="{DynamicResource importConnection}" Click="ImportConnectionClick" Margin="0,0,12,0"/><Button Content="{DynamicResource recoverConnection}" Click="RecoverConnectionClick"/></WrapPanel>
                            </StackPanel></Expander>
                        </StackPanel></TabItem>
                        <TabItem Header="{DynamicResource personalPath}"><StackPanel Margin="0,24,0,0">
                            <TextBlock Text="{DynamicResource cherryExplained}" TextWrapping="Wrap" Margin="0,0,0,20"/>
                            <TextBlock Text="{DynamicResource personalExplained}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,20"/>
                            <Button Style="{StaticResource PrimaryButton}" Content="{DynamicResource connectOwnAccount}" Click="OwnCherryClick" HorizontalAlignment="Left" Padding="24,10"/>
                            <TextBlock Text="{DynamicResource noRentDuringSetup}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,16,0,0"/>
                        </StackPanel></TabItem>
                    <TabItem Header="{DynamicResource sharedPath}"><StackPanel Margin="0,24,0,0"><TextBlock Text="{DynamicResource sharedPathHelp}" TextWrapping="Wrap" Margin="0,0,0,20"/><StackPanel x:Name="SharedOwnerEntry" Visibility="Collapsed" Margin="0,0,0,24"><TextBlock Text="{DynamicResource sharedSavedOwners}" Margin="0,0,0,8"/><TextBlock x:Name="SharedOwnerLabel" Margin="0,0,0,12"/><ComboBox x:Name="SharedOwners" DisplayMemberPath="Label" Margin="0,0,0,12"/><Button Content="{DynamicResource login}" Click="SharedOwnerLoginClick" HorizontalAlignment="Left" Style="{StaticResource PrimaryButton}"/><Button Content="{DynamicResource sharedRemoveButton}" Click="RemoveSharedHostingClick" HorizontalAlignment="Left" Margin="0,12,0,0"/></StackPanel><Button Content="{DynamicResource sharedSetupTitle}" Click="SharedHostingClick" HorizontalAlignment="Left" Style="{StaticResource PrimaryButton}" Padding="24,10"/><TextBlock Text="{DynamicResource noRentDuringSetup}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,16,0,0"/></StackPanel></TabItem></TabControl>
