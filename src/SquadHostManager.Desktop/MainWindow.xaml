        <Button Click="MaximizeWindowClick" ToolTip="{DynamicResource windowMaximize}" AutomationProperties.Name="{DynamicResource windowMaximize}"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource CaptionButton}"><Setter Property="Content" Value="&#xE922;"/><Style.Triggers><DataTrigger Binding="{Binding WindowState,RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized"><Setter Property="Content" Value="&#xE923;"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
        <Button Style="{StaticResource CaptionButton}" Content="&#xE8BB;" Click="CloseWindowClick" ToolTip="{DynamicResource windowClose}" AutomationProperties.Name="{DynamicResource windowClose}"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center"><Image Source="{StaticResource AppLogo}" SnapsToDevicePixels="True" UseLayoutRounding="True" Width="22" Height="22" Margin="0,0,10,0"/><TextBlock Text="Squad Server Manager" FontSize="12" FontWeight="Medium" VerticalAlignment="Center" Foreground="{StaticResource TextBrush}"/></StackPanel>
        </DockPanel></Border>
    <Grid>
        <Border Width="240" HorizontalAlignment="Left" Visibility="{Binding Visibility,ElementName=Workspace}" IsHitTestVisible="False"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#202C16" Offset="0"/><GradientStop Color="#10110F" Offset="0.55"/></LinearGradientBrush></Border.Background></Border>
        <Border Width="364" HorizontalAlignment="Right" Visibility="{Binding Visibility,ElementName=Workspace}" IsHitTestVisible="False"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#302F20" Offset="0"/><GradientStop Color="#12140F" Offset="0.55"/></LinearGradientBrush></Border.Background></Border>
    <Grid Margin="24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="216"/><ColumnDefinition Width="*"/><ColumnDefinition Width="340"/></Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
            <Viewbox x:Name="BrandMark" Width="208" Height="75" Stretch="Uniform" HorizontalAlignment="Left" AutomationProperties.Name="Squad Server Manager">
                <Grid Width="300" Height="108">
                    <Path Fill="#EEF1E8" Data="M63 35 L72 59 L215 59 L69 66 L63 49 L58 66 L43 66 L54 73 L44 94 L62 78 L30 112 L48 75 L25 59 L54 58 Z"><Path.RenderTransform><MatrixTransform Matrix="1.38,0,0,1.38,-34.5,-48.3"/></Path.RenderTransform></Path>
                    <StackPanel Margin="80,46,0,0" VerticalAlignment="Top" TextElement.FontFamily="Bahnschrift, Segoe UI" TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="Grayscale"><TextBlock Text="Squad Server" FontSize="23" LineHeight="27" FontWeight="SemiBold" FontStretch="SemiCondensed"/><TextBlock Text="Manager" FontSize="23" LineHeight="27" FontWeight="SemiBold" FontStretch="SemiCondensed"/></StackPanel>
                </Grid>
            </Viewbox>
            <TextBlock x:Name="VersionLabel" Visibility="Collapsed"/>
        </StackPanel>
        <TextBlock x:Name="PageHeading" Grid.Column="1" FontSize="18" FontWeight="Medium" Margin="24,0,0,0" VerticalAlignment="Center"/>
        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button x:Name="NoticeBell" Margin="0,0,12,0" Padding="10,6" Click="NoticeBellClick" Visibility="{Binding Visibility,ElementName=Workspace}" ToolTip="{DynamicResource notifications}" AutomationProperties.Name="{DynamicResource notifications}"><StackPanel Orientation="Horizontal"><Canvas Width="20" Height="20" VerticalAlignment="Center"><Path Data="M5 13 V9 Q5 4 10 4 Q15 4 15 9 V13 L17 15 H3 Z M8 17 Q10 20 12 17 M10 2 V4" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Canvas><Border x:Name="NoticeBadge" Background="{StaticResource AccentBrush}" CornerRadius="10" Height="20" MinWidth="20" VerticalAlignment="Center" Margin="6,0,0,0" Padding="5,0" Visibility="Collapsed"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" LineHeight="14" TextAlignment="Center" x:Name="NoticeBadgeCount" Foreground="#14200D" FontSize="11" FontWeight="SemiBold"/></Border></StackPanel></Button><TextBlock x:Name="AccountLabel" Margin="0,0,18,0" VerticalAlignment="Center"/><ComboBox x:Name="LanguagePicker" Width="150" SelectionChanged="LanguageChanged" AutomationProperties.Name="{DynamicResource language}">
                    <ComboBoxItem Tag="ru">Русский</ComboBoxItem>
