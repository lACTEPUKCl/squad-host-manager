                            </StackPanel><Expander x:Name="ExistingOwnerLogin" Expanded="OwnerLoginExpanded" Collapsed="OwnerLoginCollapsed" Header="{DynamicResource existingAdminLogin}" Margin="0,28,0,0"><StackPanel Margin="0,16,0,0">
                                <TextBlock Text="{DynamicResource existingAdminHelp}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,16"/>
                                <Label Content="{DynamicResource managementAddress}" Padding="0" Target="{Binding ElementName=Endpoint}"/>
