                    <DataGridTemplateColumn Header="{DynamicResource username}" Width="2*" MinWidth="160"><DataGridTemplateColumn.CellTemplate><DataTemplate><Grid VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="#B2FF59" Width="28" Height="28" CornerRadius="14" HorizontalAlignment="Left"><TextBlock Text="{Binding Initial}" Foreground="#14200D" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13"/></Border><TextBlock Grid.Column="1" Text="{Binding Name}" ToolTip="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/></Grid></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="{DynamicResource currency}" Binding="{Binding Currency}" Width="*" MinWidth="75"/><DataGridTextColumn Header="{DynamicResource spent}" Binding="{Binding Spent,StringFormat=F3}" Width="*" MinWidth="100"/><DataGridTextColumn Header="{DynamicResource separateHostsCost}" Binding="{Binding SeparateHosts,StringFormat=F3}" Width="1.5*" MinWidth="150"/><DataGridTemplateColumn Header="{DynamicResource savedMoney}" Width="1.2*" MinWidth="130"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding Saved,StringFormat=F3}" FontSize="12"/><ProgressBar Value="{Binding SavingsPercent,Mode=OneWay}" Height="4" Maximum="100" Width="80" HorizontalAlignment="Left" Margin="0,6,0,0"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                    </DataGrid.Columns></DataGrid><StackPanel Grid.Row="5" Margin="0,14,0,0"><TextBlock x:Name="StatisticsNotes" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap"/><TextBlock Text="{DynamicResource statisticsHelp}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel>
                    </Grid>
                </TabItem>
                <TabItem x:Name="FeaturesTab" Header="{DynamicResource automation}" Tag="M10 6 A4 4 0 1 1 10 14 A4 4 0 1 1 10 6 M10 2 V4 M10 16 V18 M2 10 H4 M16 10 H18 M4 4 L6 6 M14 14 L16 16 M4 16 L6 14 M14 6 L16 4"><ContentControl x:Name="FeatureHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/></TabItem>
            </TabControl>
            </DockPanel>
            <Border Grid.Column="1" CornerRadius="0" Padding="24,28"><Border.Background><SolidColorBrush Color="Transparent"/></Border.Background>
            <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
            <TextBlock Text="{DynamicResource hostOverview}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16"/>
            <Border Background="#242A1D" CornerRadius="6" Padding="12,10" Margin="0,0,0,24"><TextBlock Text="{Binding Text,ElementName=HostStatus}" TextWrapping="Wrap" FontSize="14" FontWeight="Medium"/></Border>
            <TextBlock Text="{DynamicResource hostAddress}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,0,6"/>
            <TextBlock x:Name="OverviewAddress" TextWrapping="Wrap" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock x:Name="OverviewLocation" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"/>
            <TextBlock x:Name="OverviewRenter" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,0"/>
            <Grid x:Name="OverviewRental" Margin="0,24,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="{DynamicResource hostHourlyCost}" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap"/><TextBlock x:Name="OverviewHourly" FontSize="17" FontWeight="Medium" Margin="0,6,0,0" TextWrapping="Wrap"/></StackPanel>
            <StackPanel Grid.Column="2"><TextBlock Text="{DynamicResource hostPersonalSpent}" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap"/><TextBlock x:Name="OverviewSpent" FontSize="17" FontWeight="Medium" Margin="0,6,0,0" TextWrapping="Wrap"/></StackPanel></Grid>
            <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,24"/>
            <DockPanel Margin="0,0,0,8"><TextBlock x:Name="OverviewCount" DockPanel.Dock="Right" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/><TextBlock Text="{DynamicResource server}" FontSize="18" FontWeight="SemiBold"/></DockPanel>
            <ItemsControl x:Name="OverviewServers"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Ellipse Width="7" Height="7" Fill="{Binding DotColor}" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,7,0,0"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/><TextBlock Text="{Binding State}" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0"/><TextBlock Text="{Binding PasswordLabel}" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0"/></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            <TextBlock x:Name="OverviewEmpty" Text="{DynamicResource noServers}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0"/>
            <TextBlock Text="{DynamicResource balanceLabel}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,24,0,8"/>
            <TextBlock x:Name="AccountBalance" Text="—" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,16"/>
            </StackPanel></ScrollViewer></Border>
            </Grid>
        </Grid>
        <StackPanel Grid.Row="2" Margin="0,16,0,0">
            <ProgressBar x:Name="Activity" Height="3" IsIndeterminate="True" Visibility="Hidden" Margin="0,0,0,10" />
            <TextBlock x:Name="Status" Text="{DynamicResource noConnection}" TextWrapping="Wrap" Width="192" HorizontalAlignment="Left" FontSize="12" LineHeight="18" />
            <Expander x:Name="ErrorPanel" Header="{DynamicResource details}" Visibility="Collapsed" Margin="0,6,0,0">
                <TextBox x:Name="ErrorDetails" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="100" VerticalScrollBarVisibility="Auto" Padding="9,6" Margin="0,5,0,14" MinHeight="34" />
            </Expander>
        </StackPanel>
    </Grid>
    </Grid>
    </DockPanel>
</Window>

