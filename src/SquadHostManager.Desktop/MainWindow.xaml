    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" Height="36" Background="#11140E" BorderBrush="#252B20" BorderThickness="0,0,0,1"><DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
