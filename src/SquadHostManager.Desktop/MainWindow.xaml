                            <Border x:Name="SharedHostSummary" Visibility="Collapsed" Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="24" Margin="0,0,0,24"><StackPanel>
                                <TextBlock x:Name="SharedHostModel" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock x:Name="SharedHostInfo" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,12,0,16"/>
