                        </StackPanel><StackPanel x:Name="RentalHistoryPanel" Grid.Column="2" Margin="0,0,0,0"><TextBlock Text="{DynamicResource rentalHistory}" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="RentalTotals" TextWrapping="Wrap" Margin="0,10"/><ScrollViewer MaxHeight="170" VerticalScrollBarVisibility="Auto" Focusable="False"><TextBlock x:Name="RentalHistoryText" TextWrapping="Wrap" Focusable="False" IsHitTestVisible="False" Cursor="Arrow"/></ScrollViewer><TextBlock Text="{DynamicResource rentalEstimateHelp}" TextWrapping="Wrap" Opacity="0.7" Margin="0,8"/></StackPanel></Grid>
                        <DataGrid x:Name="Servers" Grid.Row="2" MinHeight="160" MaxHeight="420" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" CanUserAddRows="False" SelectionMode="Single" PreviewMouseDown="IgnoreServerSelection" Focusable="False" RowHeight="44">
