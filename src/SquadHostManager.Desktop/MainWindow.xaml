                        </Grid.RowDefinitions>
                        <DockPanel>


                            <TextBlock x:Name="HostStatus" Style="{StaticResource Heading}" TextWrapping="Wrap" />
                        </DockPanel>
                        <Grid x:Name="HostingLayout" Grid.Row="1" Margin="0,0,0,24"><Grid.ColumnDefinitions><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel>
