<Window x:Class="SquadHostManager.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:SquadHostManager.Desktop" Title="Squad Server Manager" Icon="{StaticResource AppLogo}" WindowStyle="None" ResizeMode="CanResize" Width="1640" Height="1040" WindowState="Normal" WindowStartupLocation="CenterScreen" MinWidth="1240" MinHeight="680" FontFamily="{StaticResource DashboardFont}" FontSize="14" ThemeMode="Dark" Background="{StaticResource CanvasBrush}" Foreground="{StaticResource TextBrush}" Closing="OnClosing">
